{
  "name": "backend",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:linux": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile ./dist/server ./src/index.ts",
    "build:windows": "bun build --compile --minify-whitespace --minify-syntax --target=bun-windows-x64 --outfile ./dist/server.exe ./src/index.ts",
    "pg-push": "bun drizzle-kit push",
    "pg-generate": "bun drizzle-kit generate",
    "pg-migrate": "bun drizzle-kit migrate"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@logtape/file": "^2.0.2",
    "@logtape/logtape": "^2.0.2",
    "@logtape/pretty": "^2.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.28",
    "jsonwebtoken": "^9.0.3",
    "neverthrow": "^8.2.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "typescript-eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.6"
  },
  "module": "src/index.ts"
}
